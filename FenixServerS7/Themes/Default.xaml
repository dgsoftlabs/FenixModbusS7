<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Window">
        <Setter Property="MinWidth" Value="960" />
        <Setter Property="MinHeight" Value="640" />
        <Setter Property="Background" Value="#F6F8FB" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F8" />
        <Setter Property="VerticalGridLinesBrush" Value="#F3F6FB" />
        <Setter Property="BorderBrush" Value="#E6EBF3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>
    <Style TargetType="ListView">
        <Setter Property="BorderBrush" Value="#D9DEE7" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
