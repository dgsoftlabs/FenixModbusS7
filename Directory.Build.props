<Project>
  <!-- Suppress xUnit buildTransitive entry point generation for non-test projects.
       This must be set BEFORE xunit targets are imported. Individual test projects
       override this by setting <IsTestProject>true</IsTestProject> in their csproj. -->
  <PropertyGroup>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
</Project>
